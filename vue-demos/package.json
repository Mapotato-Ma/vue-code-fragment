{
  "name": "vue-demos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview",
    "preview:prod": "vite preview --port 5050",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "build": "run-p type-check build:prod",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "deploy": "run-s build:prod zip upload unzip-remote",
    "zip": "powershell -Command \"Compress-Archive -Path ./mapotato/* mapotato.zip -Force\"",
    "upload": "scp ./mapotato.zip 腾讯云:/var/www/html/",
    "unzip-remote": "ssh 腾讯云 \"cd /var/www/html && rm -rf mapotato/* && unzip -o mapotato.zip -d mapotato\""
  },
  "dependencies": {
    "@mapotato-pkg/hello-wasm": "^0.2.0",
    "@tresjs/cientos": "^5.9.3",
    "@tresjs/core": "^5.9.3",
    "@tresjs/post-processing": "^3.10.0",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "big.js": "^7.0.1",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "monaco-themes": "^0.4.8",
    "rxjs": "^7.8.2",
    "three": "^0.186.1",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-icons-plus": "^0.1.8",
    "vue-router": "^5.4.0",
    "vue-showdown": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/babel__core": "^7.20.5",
    "@types/big.js": "^7.0.0",
    "@types/ejs": "^3.1.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "ejs": "^7.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
